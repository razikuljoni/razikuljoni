PUBLIC_SITE_NAME="MD Razikul Islam Joni"
PUBLIC_SITE_DESCRIPTION="Jr. Full-Stack Developer | Next.js, React, Node.js, PostgreSQL"

# ============================================
# Personal Information
# ============================================
PUBLIC_EMAIL=razikuljoni@gmail.com
PUBLIC_GITHUB=razikuljoni
PUBLIC_LINKEDIN=razikuljoni
PUBLIC_TWITTER=razikuljoni
PUBLIC_LOCATION="Dhaka, Bangladesh"
PUBLIC_TIMEZONE="Asia/Dhaka"

# Optional Social Profiles
PUBLIC_KAGGLE=razikuljoni
PUBLIC_BLUESKY=razikuljoni.xyz
PUBLIC_ORCID=0009-0005-2980-6651

# ============================================
# Database Configuration (Turso/libSQL)
# ============================================
# For local development with SQLite, you can use:
# TURSO_DATABASE_URL="file:local.db"
# TURSO_AUTH_TOKEN=""
#
# For production with Turso:
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-auth-token"

# ============================================
# Redis Configuration (Optional - for caching)
# ============================================
# Upstash Redis or local Redis
REDIS_URL="redis://localhost:6379"
# or use KV_REDIS_URL for Vercel KV

# ============================================
# Storage Configuration (Optional - for image uploads)
# ============================================
# Cloudflare R2 or compatible S3 storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ============================================
# External API Keys (Optional)
# ============================================
# GitHub API for activity metrics
# If not configured, the site will show placeholder data
GITHUB_TOKEN=""

# WakaTime for coding activity tracking
# If not configured, the site will show placeholder data
WAKATIME_API_KEY=""

# ============================================
# Contact Form (Telegram)
# ============================================
BOT_TOKEN=""
CHAT_ID=""

# ============================================
# Admin Credentials
# ============================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-password-change-this"

# ============================================
# MCP Server (mcp/)
# ============================================
# Shared secret required by every MCP tool call. Generate with:
#   openssl rand -hex 32
PORTFOLIO_MCP_TOKEN=""
