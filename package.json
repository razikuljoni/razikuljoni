{
  "name": "subsequent-solstice",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "TURSO_DATABASE_URL=\"file:local.db\" drizzle-kit generate",
    "db:push": "TURSO_DATABASE_URL=\"file:local.db\" drizzle-kit push",
    "db:seed": "TURSO_DATABASE_URL=\"file:local.db\" tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "deploy": "vercel --prod",
    "push:env": "tsx scripts/push-env.ts",
    "mcp:build": "pnpm --prefix mcp run build",
    "mcp:start": "node mcp/dist/index.js",
    "mcp:dev": "node mcp/src/index.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.13",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "3.7.0",
    "@astrojs/vercel": "^9.0.4",
    "@aws-sdk/client-s3": "^3.983.0",
    "@libsql/client": "^0.17.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "5.16.15",
    "astro-remote": "^0.3.4",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.556.0",
    "mermaid": "^11.12.2",
    "plotly.js": "^3.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-github-calendar": "^5.0.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.21.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "unified": "^11.0.5"
  },
  "devDependencies": {},
  "pnpm": {
    "public-hoist-pattern": [
      "*astro*",
      "*vercel*",
      "*react*"
    ]
  }
}
