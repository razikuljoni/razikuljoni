{
  "name": "subsequent-solstice",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "TURSO_DATABASE_URL=\"file:local.db\" drizzle-kit generate",
    "db:push": "TURSO_DATABASE_URL=\"file:local.db\" drizzle-kit push",
    "db:seed": "TURSO_DATABASE_URL=\"file:local.db\" tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "deploy": "vercel --prod",
    "push:env": "tsx scripts/push-env.ts",
    "mcp:build": "pnpm --prefix mcp run build",
    "mcp:start": "node mcp/dist/index.js",
    "mcp:dev": "node mcp/src/index.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "^11.0.20",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "astro": "7.4.7",
    "astro-remote": "^0.3.4",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.6.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "glob": "^14.0.4",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "plotly.js": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-github-calendar": "^5.0.9",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.6",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "unified": "^11.0.5",
    "wrangler": "^4.158.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@libsql/client",
      "@swc/core",
      "esbuild",
      "sharp"
    ],
    "public-hoist-pattern": [
      "*"
    ],
    "overrides": {
      "astro": "$astro"
    }
  }
}
